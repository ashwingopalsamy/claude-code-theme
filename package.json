{
  "name": "claude-code-theme",
  "displayName": "Claude Code Theme",
  "description": "Warm, calm Claude-inspired themes. 10 flavors (dark, light, OLED midnight, dusk, mono, brand, high contrast), each with a no-bold twin.",
  "version": "1.3.0",
  "publisher": "ashwingopalsamy",
  "author": {
    "name": "Ashwin Gopalsamy",
    "url": "https://github.com/ashwingopalsamy"
  },
  "homepage": "https://github.com/ashwingopalsamy/claude-code-theme#readme",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "vscode": "^1.80.0",
    "node": ">=20.0.0"
  },
  "categories": [
    "Themes"
  ],
  "keywords": [
    "theme",
    "claude",
    "anthropic",
    "light-theme",
    "dark-theme",
    "syntax-highlighting",
    "accessibility",
    "developer-ergonomics",
    "cursor",
    "windsurf",
    "oled",
    "warm",
    "orange",
    "minimal",
    "monochrome",
    "no-bold",
    "high-contrast"
  ],
  "icon": "logo.png",
  "galleryBanner": {
    "color": "#C96442",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ashwingopalsamy/claude-code-theme.git"
  },
  "bugs": {
    "url": "https://github.com/ashwingopalsamy/claude-code-theme/issues"
  },
  "contributes": {
    "themes": [
      {
        "label": "Claude Code Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dark.json"
      },
      {
        "label": "Claude Code Dark High Contrast",
        "uiTheme": "hc-black",
        "path": "./themes/claude-code-dark-high-contrast.json"
      },
      {
        "label": "Claude Code Dark Brand",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dark-brand.json"
      },
      {
        "label": "Claude Code Light",
        "uiTheme": "vs",
        "path": "./themes/claude-code-light.json"
      },
      {
        "label": "Claude Code Light High Contrast",
        "uiTheme": "hc-light",
        "path": "./themes/claude-code-light-high-contrast.json"
      },
      {
        "label": "Claude Code Light Brand",
        "uiTheme": "vs",
        "path": "./themes/claude-code-light-brand.json"
      },
      {
        "label": "Claude Code Midnight",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-midnight.json"
      },
      {
        "label": "Claude Code Dusk",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dusk.json"
      },
      {
        "label": "Claude Code Mono Dark",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-mono-dark.json"
      },
      {
        "label": "Claude Code Mono Light",
        "uiTheme": "vs",
        "path": "./themes/claude-code-mono-light.json"
      },
      {
        "label": "Claude Code Dark (No Bold)",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dark-no-bold.json"
      },
      {
        "label": "Claude Code Dark High Contrast (No Bold)",
        "uiTheme": "hc-black",
        "path": "./themes/claude-code-dark-high-contrast-no-bold.json"
      },
      {
        "label": "Claude Code Dark Brand (No Bold)",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dark-brand-no-bold.json"
      },
      {
        "label": "Claude Code Light (No Bold)",
        "uiTheme": "vs",
        "path": "./themes/claude-code-light-no-bold.json"
      },
      {
        "label": "Claude Code Light High Contrast (No Bold)",
        "uiTheme": "hc-light",
        "path": "./themes/claude-code-light-high-contrast-no-bold.json"
      },
      {
        "label": "Claude Code Light Brand (No Bold)",
        "uiTheme": "vs",
        "path": "./themes/claude-code-light-brand-no-bold.json"
      },
      {
        "label": "Claude Code Midnight (No Bold)",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-midnight-no-bold.json"
      },
      {
        "label": "Claude Code Dusk (No Bold)",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-dusk-no-bold.json"
      },
      {
        "label": "Claude Code Mono Dark (No Bold)",
        "uiTheme": "vs-dark",
        "path": "./themes/claude-code-mono-dark-no-bold.json"
      },
      {
        "label": "Claude Code Mono Light (No Bold)",
        "uiTheme": "vs",
        "path": "./themes/claude-code-mono-light-no-bold.json"
      }
    ]
  },
  "scripts": {
    "build": "tsx build.ts",
    "check": "pnpm build && pnpm compile && pnpm contrast && pnpm test:theme",
    "contrast": "tsx scripts/contrast-report.ts",
    "shots": "tsx scripts/shots/render.ts",
    "test:theme": "node test/theme-quality.test.mjs",
    "package": "vsce package",
    "publish:marketplace": "vsce publish",
    "publish:openvsx": "ovsx publish",
    "compile": "tsc --noEmit"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.80.0",
    "@vscode/vsce": "^2.22.0",
    "ovsx": "^0.9.3",
    "playwright": "^1.64.0",
    "sharp": "^0.35.5",
    "shiki": "^4.5.0",
    "tsx": "^4.6.0",
    "typescript": "^5.3.0"
  }
}
